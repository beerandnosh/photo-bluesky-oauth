{
  "client_id": "https://beerandnosh.github.io/photo-bluesky-oauth/client-metadata.json",
  "application_type": "native",
  "client_name": "Pushsky",
  "redirect_uris": [
    "io.github.beerandnosh:/oauth/callback"
  ],
  "grant_types": [
    "authorization_code",
    "refresh_token"
  ],
  "response_types": [
    "code"
  ],
  "scope": "atproto repo:app.bsky.feed.post?action=create blob:image/* repo:app.bsky.feed.like?action=create&action=delete repo:app.bsky.feed.repost?action=create&action=delete repo:app.bsky.graph.follow?action=create&action=delete include:app.bsky.authViewAll?aud=did:web:api.bsky.app%23bsky_appview include:app.bsky.authManageModeration?aud=did:web:api.bsky.app%23bsky_appview rpc:com.atproto.moderation.createReport?aud=*",
  "token_endpoint_auth_method": "none",
  "dpop_bound_access_tokens": true
}
